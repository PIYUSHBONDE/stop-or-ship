# Copy to .env and replace the example values. On Windows, COMPOSE_FILE uses ';'.
COMPOSE_FILE=compose.yaml;compose.local.yaml
PLANTSENSE_MODE=local
PLANTSENSE_AI_PROVIDER=scripted
GEMINI_MODEL=gemini-3.5-flash
GOOGLE_CLOUD_LOCATION=global
PLANTSENSE_CLOUD_SQL_INSTANCE=project-970d28ee-835b-4ca2-866:asia-south1:plantsense-pilot
PLANTSENSE_ADC_FILE=C:/Users/your-name/AppData/Roaming/gcloud/application_default_credentials.json

# Local app credentials. Keep this file private and ignored by Git.
DATABASE_URL=postgresql://plantsense_app:replace-me@cloud-sql-proxy:5432/plantsense
PLANTSENSE_POSTGRES_EVIDENCE_DSN=host=cloud-sql-proxy port=5432 dbname=plantsense user=plantsense_evidence password=replace-me

PLANTSENSE_WEB_PORT=3000
DAILY_AI_LIMIT=60
DAILY_AI_SPEND_MICRO_USD=2000000
INVESTIGATION_AI_SPEND_MICRO_USD=750000
# Live local execution additionally requires a matching passing evaluation report.
# See docs/operations/live-gemini.md. Credentials stay outside the repository.
# Cloud mode additionally needs GOOGLE_CLOUD_PROJECT, Firebase config, and the task worker settings.
