# Local development needs no secrets. Backend reads this file only with uvicorn --env-file.
PLANTSENSE_MODE=local
PLANTSENSE_AI_PROVIDER=scripted
GEMINI_MODEL=gemini-3.5-flash
GOOGLE_CLOUD_LOCATION=global
DAILY_AI_LIMIT=60
DAILY_AI_SPEND_MICRO_USD=2000000
INVESTIGATION_AI_SPEND_MICRO_USD=750000
# Live local execution additionally requires a matching passing evaluation report.
# See docs/operations/live-gemini.md. Credentials stay outside the repository.
# Cloud mode additionally needs GOOGLE_CLOUD_PROJECT, Firebase config, and the task worker settings.
