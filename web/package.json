{
  "name": "plantsense-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "node scripts/start.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "generate:api": "openapi-typescript contracts/openapi.json -o src/lib/generated/api-schema.ts",
    "test:e2e": "playwright test tests/e2e",
    "format": "prettier --write src contracts tests scripts *.ts *.mjs *.json",
    "format:check": "prettier --check src contracts tests scripts *.ts *.mjs *.json",
    "check:api": "npm run generate:api -- --check",
    "test:unit": "playwright test tests/unit"
  },
  "dependencies": {
    "@firebase/app": "0.16.2",
    "@firebase/auth": "1.13.6",
    "@radix-ui/react-dialog": "1.1.23",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.1",
    "lucide-react": "1.52.0",
    "next": "16.3.8",
    "openapi-fetch": "0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1"
  }
}
